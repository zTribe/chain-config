{
  "name": "@ztribe/chain-config",
  "version": "0.3.0",
  "type": "module",
  "description": "Versioned EVM chain registry and policy for zTribe",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./validate": "./validate.mjs"
  },
  "files": [
    "chains",
    "schema",
    "index.mjs",
    "index.d.mts",
    "registry.generated.mjs",
    "validate.mjs",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-registry.mjs",
    "check:registry": "node scripts/generate-registry.mjs --check",
    "test": "npm run check:registry && node --test test/*.test.mjs"
  },
  "types": "./index.d.mts"
}

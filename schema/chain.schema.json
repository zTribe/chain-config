{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zTribe EVM chain configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "slug",
    "name",
    "nativeCurrency",
    "tokens",
    "contracts",
    "oracles",
    "payments",
    "reserve",
    "valuation",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "chainId": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nativeCurrency": {
      "$ref": "#/$defs/native"
    },
    "tokens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/token"
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrappedNative"
      ],
      "properties": {
        "wrappedNative": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "oracles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/oracle"
      }
    },
    "payments": {
      "$ref": "#/$defs/payments"
    },
    "reserve": {
      "$ref": "#/$defs/reserve"
    },
    "valuation": {
      "$ref": "#/$defs/valuation"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "decimals",
        "icon"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "symbol",
        "icon"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "adapter"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "adapter": {
          "enum": [
            "chainlink-aggregator-v3",
            "binance-oracle-aggregator-v3"
          ]
        }
      }
    },
    "payments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directAssets",
        "dynamicTribeToken",
        "dynamicQuoteToken",
        "fallbackSwapAsset"
      ],
      "properties": {
        "directAssets": {
          "$ref": "#/$defs/keys"
        },
        "dynamicTribeToken": {
          "type": "boolean"
        },
        "dynamicQuoteToken": {
          "type": "boolean"
        },
        "fallbackSwapAsset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayAssets",
        "dynamicTribeToken",
        "dynamicQuoteToken"
      ],
      "properties": {
        "displayAssets": {
          "$ref": "#/$defs/keys"
        },
        "dynamicTribeToken": {
          "type": "boolean"
        },
        "dynamicQuoteToken": {
          "type": "boolean"
        }
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeOracle",
        "stablecoinCandidates",
        "assumeTestnetRealUsd"
      ],
      "properties": {
        "nativeOracle": {
          "type": [
            "string",
            "null"
          ]
        },
        "stablecoinCandidates": {
          "$ref": "#/$defs/keys"
        },
        "assumeTestnetRealUsd": {
          "type": "boolean"
        }
      }
    },
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payments",
        "reserve",
        "valuation"
      ],
      "properties": {
        "payments": {
          "type": "boolean"
        },
        "reserve": {
          "type": "boolean"
        },
        "valuation": {
          "type": "boolean"
        }
      }
    }
  }
}
